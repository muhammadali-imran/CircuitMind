# Copy this file to .env and fill in your values
# Never commit .env to version control

GROQ_API_KEY=your_groq_api_key_here

# Optional: lock the API behind an X-API-Key header (unset = open access)
CIRCUITMIND_API_KEY=

# Optional: comma-separated list of allowed CORS origins (default: local Streamlit/dev ports)
# ALLOWED_ORIGINS=https://yourfrontend.com,https://app.yoursite.com

# Optional: Redis connection string so rate limits hold across serverless
# instances / multiple workers (falls back to in-memory otherwise)
# RATE_LIMIT_REDIS_URL=redis://default:password@host:port

# Optional: LangSmith tracing for the gateway agent (debugging tool calls)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=circuitmind
